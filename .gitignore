# ---------------------------------------------------------------------------
# Project outputs. None of these belong in the repository: they are either
# machine-local scratch or gigabytes of model weights.
# ---------------------------------------------------------------------------

# torchmanager experiment directories (checkpoints + per-run logs), written by
# train_*.py and recreated by eval_*.py on every node
experiments/

# the final `torch.save` of each training run
trained_models/

# stdout of the detached shards launched by run_all_*.sh. Verbose by design
# (--show_verbose keeps every tqdm redraw), hundreds of MB per full run.
logs_add_root/
logs_add_eval/
logs_bonn_eval/
logs_*/
